{% doc %}
  @prompt
    Create a delivery-estimate info block that appears on the product page. It should display a "Shipping 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shipping-estimate-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-shipping-estimate-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-shipping-estimate-{{ ai_gen_id }}__icon {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    color: {{ block.settings.icon_color }};
  }

  .ai-shipping-estimate-{{ ai_gen_id }}__copy {
    min-width: 0;
  }

  .ai-shipping-estimate-{{ ai_gen_id }}__title {
    margin: 0 0 4px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-shipping-estimate-{{ ai_gen_id }}__delivery {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-shipping-estimate-{{ ai_gen_id }}__note {
    margin: 4px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 13px;
    line-height: 1.45;
  }

  @media screen and (max-width: 749px) {
    .ai-shipping-estimate-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-shipping-estimate-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shipping-estimate-{{ ai_gen_id }}__inner">
    <svg class="ai-shipping-estimate-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 6.5h11v11H3zM14 10h4l3 3v4h-7z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="7.5" cy="18" r="1.8" fill="{{ block.settings.background_color }}" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="17.5" cy="18" r="1.8" fill="{{ block.settings.background_color }}" stroke="currentColor" stroke-width="1.7"/>
    </svg>
    <div class="ai-shipping-estimate-{{ ai_gen_id }}__copy">
      {% if block.settings.heading != blank %}
        <p class="ai-shipping-estimate-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</p>
      {% endif %}
      {% if block.settings.delivery_text != blank %}
        <p class="ai-shipping-estimate-{{ ai_gen_id }}__delivery">{{ block.settings.delivery_text | escape }}</p>
      {% endif %}
      {% if block.settings.note != blank %}
        <p class="ai-shipping-estimate-{{ ai_gen_id }}__note">{{ block.settings.note | escape }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shipping estimate",
  "settings": [
    {
      "type": "header",
      "content": "Delivery details"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping estimate"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery estimate",
      "default": "Estimated delivery: 5–8 business days"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Additional note",
      "default": "Delivery timing may vary by destination."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F7F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#D8D8D4"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#242424"
    }
  ],
  "presets": [
    {
      "name": "Shipping estimate"
    }
  ],
  "tag": null,
  "class": "shipping-estimate-block"
}
{% endschema %}