{% liquid
  assign customer_account_client_id = section.settings.customer_account_client_id | strip
  assign customer_account_redirect_path = section.settings.customer_account_redirect_path | strip | default: '/account/authorize'
  assign shop_app_url = section.settings.shop_app_url | strip | default: shop.secure_url
  assign shop_base_url = shop.secure_url
  assign shop_domain = shop.permanent_domain
  assign account_url = routes.account_url
  assign account_login_url = routes.account_login_url
  assign account_register_url = routes.account_register_url
  assign account_logout_url = routes.account_logout_url
  assign account_addresses_url = routes.account_addresses_url
  assign storefront_login_url = routes.storefront_login_url | default: routes.account_login_url
  assign account_order_history_url = routes.account_url
  assign currency_code = cart.currency.iso_code | default: shop.currency
  assign customer_account_snapshot = 'null'

  if customer
    capture customer_account_snapshot
      {
        "customer": {
          "firstName": {{ customer.first_name | json }},
          "lastName": {{ customer.last_name | json }},
          "email": {{ customer.email | json }},
          "phone": {{ customer.phone | json }}
        },
        "orders": {{ customer.orders | json }}
      }
    endcapture
  endif
%}

<div
  id="root"
  data-shop-base-url="{{ shop_base_url | escape }}"
  data-shop-domain="{{ shop_domain | escape }}"
  data-shop-name="{{ shop.name | escape }}"
  data-shop-app-url="{{ shop_app_url | escape }}"
  data-customer-account-client-id="{{ customer_account_client_id | escape }}"
  data-customer-account-redirect-path="{{ customer_account_redirect_path | escape }}"
  data-account-url="{{ account_url | escape }}"
  data-account-login-url="{{ account_login_url | escape }}"
  data-account-register-url="{{ account_register_url | escape }}"
  data-account-logout-url="{{ account_logout_url | escape }}"
  data-account-addresses-url="{{ account_addresses_url | escape }}"
  data-account-order-history-url="{{ account_order_history_url | escape }}"
  data-storefront-login-url="{{ storefront_login_url | escape }}"
  data-customer-logged-in="{{ customer != nil }}"
  data-currency="{{ currency_code | escape }}"
  data-template="{{ template.name | escape }}"
  data-template-suffix="{{ template.suffix | escape }}"
>
</div>

<script>
  window.SALT_THEME_ASSETS = {
    "/brand/salt-logo.png": {{ 'brand-salt-logo.png' | asset_url | json }},
    "/brand-salt-logo.png": {{ 'brand-salt-logo.png' | asset_url | json }}
  };
  window.SALT_RUNTIME_CONTEXT = {
    shopBaseUrl: {{ shop_base_url | json }},
    shopDomain: {{ shop_domain | json }},
    shopName: {{ shop.name | json }},
    shopAppUrl: {{ shop_app_url | json }},
    customerAccountClientId: {{ customer_account_client_id | json }},
    customerAccountRedirectPath: {{ customer_account_redirect_path | json }},
    customerAccountSnapshot: {{ customer_account_snapshot | strip_newlines | strip }},
    currency: {{ currency_code | json }},
    template: {{ template.name | json }},
    templateSuffix: {{ template.suffix | json }},
    accountUrl: {{ account_url | json }},
    accountLoginUrl: {{ account_login_url | json }},
    accountRegisterUrl: {{ account_register_url | json }},
    accountLogoutUrl: {{ account_logout_url | json }},
    accountAddressesUrl: {{ account_addresses_url | json }},
    accountOrderHistoryUrl: {{ account_order_history_url | json }},
    storefrontLoginUrl: {{ storefront_login_url | json }},
    customerLoggedIn: {{ customer != nil | json }}
  };
</script>
<script type="module" src="{{ 'salt-app.js' | asset_url }}"></script>

{% schema %}
{
  "name": "SALT App",
  "settings": [
    {
      "type": "text",
      "id": "customer_account_client_id",
      "label": "Customer account client ID",
      "info": "Paste the Shopify Customer Account API client ID used for customer sign-in."
    },
    {
      "type": "text",
      "id": "customer_account_redirect_path",
      "label": "Customer account redirect path",
      "default": "/account/authorize",
      "info": "Path in this theme that receives the Shopify customer account callback."
    },
    {
      "type": "url",
      "id": "shop_app_url",
      "label": "App URL",
      "info": "Optional branded app URL used for storefront-to-app redirects."
    }
  ],
  "presets": [
    {
      "name": "SALT App"
    }
  ]
}
{% endschema %}
