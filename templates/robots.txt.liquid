{%- comment -%}
  SEO robots template for SALT Online Store.
  Keeps Shopify defaults and always exposes the primary sitemap.
{%- endcomment -%}

{%- for group in robots.default_groups -%}
User-agent: {{ group.user_agent }}
{%- for rule in group.rules -%}
{{ rule.directive }}: {{ rule.value }}
{%- endfor -%}
{%- if group.sitemap != blank -%}
Sitemap: {{ group.sitemap }}
{%- endif -%}

{%- endfor -%}
Sitemap: {{ shop.secure_url }}/sitemap.xml
