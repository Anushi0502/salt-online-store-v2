{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glow-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-glow-heading-{{ ai_gen_id }}__text {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.15;
    font-weight: 700;
    overflow-wrap: anywhere;
    animation: ai-glow-pulse-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-in-out infinite alternate;
  }

  @keyframes ai-glow-pulse-{{ ai_gen_id }} {
    from {
      text-shadow: 0 0 2px {{ block.settings.glow_color }}, 0 0 6px {{ block.settings.glow_color }};
    }
    to {
      text-shadow: 0 0 5px {{ block.settings.glow_color }}, 0 0 12px {{ block.settings.glow_color }}, 0 0 20px {{ block.settings.glow_color }};
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-glow-heading-{{ ai_gen_id }}__text {
      animation: none;
      text-shadow: 0 0 6px {{ block.settings.glow_color }};
    }
  }
{% endstyle %}

<div class="ai-glow-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-glow-heading-{{ ai_gen_id }}__text">{{ block.settings.heading | escape }}</h2>
</div>

{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make a statement"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#F2A900"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Glow speed",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "s",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Glowing heading"
    }
  ],
  "tag": null,
  "class": "glowing-heading-block"
}
{% endschema %}