{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-timeline-{{ ai_gen_id }}__heading {
    color: {{ block.settings.text_color }};
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
    margin: 0 0 2rem;
  }

  .ai-timeline-{{ ai_gen_id }}__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 2.25rem;
  }

  .ai-timeline-{{ ai_gen_id }}__list::before,
  .ai-timeline-{{ ai_gen_id }}__progress {
    position: absolute;
    left: 0.55rem;
    top: 0.5rem;
    width: 2px;
    height: calc(100% - 1rem);
    content: '';
    background: {{ block.settings.line_color }};
  }

  .ai-timeline-{{ ai_gen_id }}__progress {
    z-index: 1;
    height: var(--ai-timeline-progress, 0%);
    max-height: calc(100% - 1rem);
    background: {{ block.settings.accent_color }};
    transition: height 180ms ease-out;
  }

  .ai-timeline-{{ ai_gen_id }}__item {
    position: relative;
    padding: 0 0 2.5rem;
    opacity: 0.62;
    transition: opacity 180ms ease-out;
  }

  .ai-timeline-{{ ai_gen_id }}__item:last-child { padding-bottom: 0; }
  .ai-timeline-{{ ai_gen_id }}__item.is-active { opacity: 1; }

  .ai-timeline-{{ ai_gen_id }}__marker {
    position: absolute;
    z-index: 2;
    left: -2.25rem;
    top: 0.2rem;
    width: 1.15rem;
    height: 1.15rem;
    border: 2px solid {{ block.settings.line_color }};
    border-radius: 50%;
    background: {{ block.settings.marker_background }};
    transition: background-color 180ms ease-out, border-color 180ms ease-out, transform 180ms ease-out;
  }

  .ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__marker {
    border-color: {{ block.settings.accent_color }};
    background: {{ block.settings.accent_color }};
    transform: scale(1.12);
  }

  .ai-timeline-{{ ai_gen_id }}__date {
    display: block;
    margin: 0 0 0.4rem;
    color: {{ block.settings.accent_color }};
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .ai-timeline-{{ ai_gen_id }}__title {
    margin: 0 0 0.5rem;
    color: {{ block.settings.text_color }};
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .ai-timeline-{{ ai_gen_id }}__description {
    font-size: 1rem;
    line-height: 1.6;
  }

  .ai-timeline-{{ ai_gen_id }}__description p { margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    .ai-timeline-{{ ai_gen_id }}__item,
    .ai-timeline-{{ ai_gen_id }}__marker,
    .ai-timeline-{{ ai_gen_id }}__progress { transition: none; }
  }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-timeline-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <ol class="ai-timeline-{{ ai_gen_id }}__list" aria-label="{{ block.settings.heading | default: 'Timeline' | escape }}">
    <span class="ai-timeline-{{ ai_gen_id }}__progress" aria-hidden="true"></span>
    {% for i in (1..5) %}
      {% assign title_key = 'milestone_' | append: i | append: '_title' %}
      {% assign date_key = 'milestone_' | append: i | append: '_date' %}
      {% assign description_key = 'milestone_' | append: i | append: '_description' %}
      {% assign milestone_title = block.settings[title_key] %}
      {% assign milestone_date = block.settings[date_key] %}
      {% assign milestone_description = block.settings[description_key] %}
      {% if milestone_title != blank or milestone_date != blank or milestone_description != blank %}
        <li class="ai-timeline-{{ ai_gen_id }}__item" data-timeline-item>
          <span class="ai-timeline-{{ ai_gen_id }}__marker" aria-hidden="true"></span>
          {% if milestone_date != blank %}<span class="ai-timeline-{{ ai_gen_id }}__date">{{ milestone_date | escape }}</span>{% endif %}
          {% if milestone_title != blank %}<h3 class="ai-timeline-{{ ai_gen_id }}__title">{{ milestone_title | escape }}</h3>{% endif %}
          {% if milestone_description != blank %}<div class="ai-timeline-{{ ai_gen_id }}__description">{{ milestone_description }}</div>{% endif %}
        </li>
      {% endif %}
    {% endfor %}
  </ol>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'scroll-timeline-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class ScrollTimeline extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('[data-timeline-item]'));
        this.list = this.querySelector('.ai-timeline-{{ ai_gen_id }}__list');
        this.progress = this.querySelector('.ai-timeline-{{ ai_gen_id }}__progress');
        if (!this.items.length || !this.list || !this.progress) return;
        this.onScroll = this.updateActive.bind(this);
        window.addEventListener('scroll', this.onScroll, { passive: true });
        window.addEventListener('resize', this.onScroll);
        this.updateActive();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.onScroll);
        window.removeEventListener('resize', this.onScroll);
      }

      updateActive() {
        const targetY = window.innerHeight * 0.5;
        let closestIndex = 0;
        let closestDistance = Infinity;
        this.items.forEach((item, index) => {
          const rect = item.getBoundingClientRect();
          const center = rect.top + Math.min(rect.height / 2, 80);
          const distance = Math.abs(center - targetY);
          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });
        this.items.forEach((item, index) => {
          const active = index === closestIndex;
          item.classList.toggle('is-active', active);
          if (active) item.setAttribute('aria-current', 'step');
          else item.removeAttribute('aria-current');
        });
        const listRect = this.list.getBoundingClientRect();
        const firstRect = this.items[0].getBoundingClientRect();
        const activeRect = this.items[closestIndex].getBoundingClientRect();
        const progress = Math.max(0, Math.min(100, ((activeRect.top + Math.min(activeRect.height / 2, 80) - firstRect.top) / Math.max(listRect.height - 16, 1)) * 100));
        this.list.style.setProperty('--ai-timeline-progress', progress + '%');
      }
    }

    customElements.define(tagName, ScrollTimeline);
  })();
</script>

{% schema %}
{
  "name": "Scroll timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our journey" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#202020" },
    { "type": "color", "id": "accent_color", "label": "Highlight", "default": "#005A4E" },
    { "type": "color", "id": "line_color", "label": "Line", "default": "#767676" },
    { "type": "color", "id": "marker_background", "label": "Marker background", "default": "#FFFFFF" },
    { "type": "header", "content": "Milestone 1" },
    { "type": "text", "id": "milestone_1_date", "label": "Date", "default": "Step 1" },
    { "type": "text", "id": "milestone_1_title", "label": "Title", "default": "A beginning" },
    { "type": "richtext", "id": "milestone_1_description", "label": "Description", "default": "<p>Add the first moment in your story.</p>" },
    { "type": "header", "content": "Milestone 2" },
    { "type": "text", "id": "milestone_2_date", "label": "Date", "default": "Step 2" },
    { "type": "text", "id": "milestone_2_title", "label": "Title", "default": "Growing together" },
    { "type": "richtext", "id": "milestone_2_description", "label": "Description", "default": "<p>Share another important milestone.</p>" },
    { "type": "header", "content": "Milestone 3" },
    { "type": "text", "id": "milestone_3_date", "label": "Date", "default": "Step 3" },
    { "type": "text", "id": "milestone_3_title", "label": "Title", "default": "A new chapter" },
    { "type": "richtext", "id": "milestone_3_description", "label": "Description", "default": "<p>Describe what changed along the way.</p>" },
    { "type": "header", "content": "Milestone 4" },
    { "type": "text", "id": "milestone_4_date", "label": "Date", "default": "Step 4" },
    { "type": "text", "id": "milestone_4_title", "label": "Title", "default": "Making an impact" },
    { "type": "richtext", "id": "milestone_4_description", "label": "Description", "default": "<p>Highlight a meaningful achievement.</p>" },
    { "type": "header", "content": "Milestone 5" },
    { "type": "text", "id": "milestone_5_date", "label": "Date", "default": "Step 5" },
    { "type": "text", "id": "milestone_5_title", "label": "Title", "default": "Looking ahead" },
    { "type": "richtext", "id": "milestone_5_description", "label": "Description", "default": "<p>Close with what comes next.</p>" }
  ],
  "presets": [{ "name": "Scroll timeline" }],
  "tag": null,
  "class": "scroll-timeline-block"
}
{% endschema %}